<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="os.gui.controller.DashboardController"
            style="-fx-background-color: #0B0F19;">

    <!-- Sidebar -->
    <left>
        <VBox prefWidth="220" spacing="28"
              style="-fx-background-color: #111827; -fx-padding: 28 18 24 18;">

            <VBox spacing="6">
                <Label text="OS SIMULATOR"
                       style="-fx-text-fill: #818CF8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <Label text="Cloud Cluster"
                       style="-fx-text-fill: white; -fx-font-size: 21px; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="12">
                <Label text="WORKSPACE"
                       style="-fx-text-fill: #64748B; -fx-font-size: 10px; -fx-font-weight: bold;"/>

                <Button text="Dashboard" maxWidth="Infinity"
                        style="-fx-background-color: #252F45; -fx-text-fill: white; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;"/>

                <Button text="Scheduling" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-alignment: CENTER_LEFT;"/>

                <Button text="Processes" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-alignment: CENTER_LEFT;"/>

                <Button text="Performance" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-alignment: CENTER_LEFT;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="CS241 • Operating Systems"
                   style="-fx-text-fill: #64748B; -fx-font-size: 10px;"/>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox spacing="24" style="-fx-padding: 30;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Scheduling Dashboard"
                           style="-fx-text-fill: white; -fx-font-size: 25px; -fx-font-weight: bold;"/>
                    <Label text="Monitor and control your CPU scheduling simulation"
                           style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="● SYSTEM READY"
                       style="-fx-text-fill: #34D399; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Simulation Controls -->
            <VBox spacing="16"
                  style="-fx-background-color: #151D2D; -fx-background-radius: 12; -fx-padding: 20;">

                <Label text="SIMULATION CONTROL"
                       style="-fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-font-weight: bold;"/>

                <HBox spacing="12" alignment="CENTER_LEFT">

                    <VBox spacing="6">
                        <Label text="Scheduling Algorithm"
                               style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
                        <ComboBox fx:id="algorithmComboBox"
                                  prefWidth="190"
                                  promptText="Select Algorithm"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Context Switch"
                               style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
                        <TextField fx:id="contextSwitchField"
                                   text="1"
                                   prefWidth="100"
                                   promptText="Time"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Simulation Speed"
                               style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
                        <ComboBox fx:id="speedComboBox"
                                  prefWidth="130"
                                  promptText="Speed"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="startButton"
                            text="▶  Start"
                            onAction="#handleStart"
                            style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 10 20;"/>

                    <Button fx:id="pauseButton"
                            text="Ⅱ  Pause"
                            onAction="#handlePause"
                            style="-fx-background-color: #252F45; -fx-text-fill: white; -fx-background-radius: 7; -fx-padding: 10 20;"/>

                    <Button fx:id="resetButton"
                            text="↻  Reset"
                            onAction="#handleReset"
                            style="-fx-background-color: #252F45; -fx-text-fill: #F87171; -fx-background-radius: 7; -fx-padding: 10 20;"/>
                </HBox>
            </VBox>

            <!-- Statistics -->
            <GridPane hgap="14" vgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0" spacing="8"
                      style="-fx-background-color: #151D2D; -fx-background-radius: 10; -fx-padding: 18;">
                    <Label text="CURRENT TIME" style="-fx-text-fill: #94A3B8; -fx-font-size: 10px;"/>
                    <Label fx:id="currentTimeLabel" text="0"
                           style="-fx-text-fill: white; -fx-font-size: 25px; -fx-font-weight: bold;"/>
                    <Label text="Simulation clock" style="-fx-text-fill: #64748B; -fx-font-size: 10px;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" spacing="8"
                      style="-fx-background-color: #151D2D; -fx-background-radius: 10; -fx-padding: 18;">
                    <Label text="COMPLETED" style="-fx-text-fill: #94A3B8; -fx-font-size: 10px;"/>
                    <Label fx:id="completedLabel" text="0"
                           style="-fx-text-fill: #34D399; -fx-font-size: 25px; -fx-font-weight: bold;"/>
                    <Label text="Finished processes" style="-fx-text-fill: #64748B; -fx-font-size: 10px;"/>
                </VBox>

                <VBox GridPane.columnIndex="2" spacing="8"
                      style="-fx-background-color: #151D2D; -fx-background-radius: 10; -fx-padding: 18;">
                    <Label text="AVG WAITING TIME" style="-fx-text-fill: #94A3B8; -fx-font-size: 10px;"/>
                    <Label fx:id="avgWaitingLabel" text="0.0"
                           style="-fx-text-fill: #FBBF24; -fx-font-size: 25px; -fx-font-weight: bold;"/>
                    <Label text="Time units" style="-fx-text-fill: #64748B; -fx-font-size: 10px;"/>
                </VBox>

                <VBox GridPane.columnIndex="3" spacing="8"
                      style="-fx-background-color: #151D2D; -fx-background-radius: 10; -fx-padding: 18;">
                    <Label text="CPU UTILIZATION" style="-fx-text-fill: #94A3B8; -fx-font-size: 10px;"/>
                    <Label fx:id="cpuUtilizationLabel" text="0%"
                           style="-fx-text-fill: #818CF8; -fx-font-size: 25px; -fx-font-weight: bold;"/>
                    <Label text="Overall usage" style="-fx-text-fill: #64748B; -fx-font-size: 10px;"/>
                </VBox>
            </GridPane>

            <!-- Gantt Chart -->
            <VBox spacing="14" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #151D2D; -fx-background-radius: 12; -fx-padding: 20;">

                <HBox alignment="CENTER_LEFT">
                    <Label text="CPU GANTT CHART"
                           style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Timeline"
                           style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
                </HBox>

                <StackPane fx:id="ganttChartContainer"
                           VBox.vgrow="ALWAYS"
                           minHeight="150"
                           style="-fx-background-color: #0B1220; -fx-background-radius: 8;">
                    <Label text="Gantt chart will appear here"
                           style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                </StackPane>
            </VBox>

            <!-- Queue Panels -->
            <HBox spacing="14" prefHeight="150">

                <VBox spacing="12" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #151D2D; -fx-background-radius: 12; -fx-padding: 18;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="TIER 1 • ROUND ROBIN"
                               style="-fx-text-fill: #818CF8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="tier1CountLabel" text="0 processes"
                               style="-fx-text-fill: #64748B; -fx-font-size: 10px;"/>
                    </HBox>
                    <VBox fx:id="tier1QueueContainer" spacing="8">
                        <Label text="Queue is empty"
                               style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
                    </VBox>
                </VBox>

                <VBox spacing="12" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #151D2D; -fx-background-radius: 12; -fx-padding: 18;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="TIER 2 • PRIORITY"
                               style="-fx-text-fill: #FBBF24; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="tier2CountLabel" text="0 processes"
                               style="-fx-text-fill: #64748B; -fx-font-size: 10px;"/>
                    </HBox>
                    <VBox fx:id="tier2QueueContainer" spacing="8">
                        <Label text="Queue is empty"
                               style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
                    </VBox>
                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>
